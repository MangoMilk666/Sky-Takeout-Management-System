# 部署变量示例
# variables: 部署目录（宿主机），用于组织 releases/current/shared
DEPLOY_BASE_DIR=

# variables: 宿主机对外暴露的后端端口（Nginx 反代到 127.0.0.1:${APP_HOST_PORT}）
APP_HOST_PORT=

# variables: Spring Profile（推荐 prod；仅用于容器内运行时）
# 默认prod，可不填
SPRING_PROFILES_ACTIVE=prod

# variables: 时区
# 默认Asia/Shanghai，可不填
TZ=Asia/Shanghai

# variables: 上传目录（宿主机路径，会挂载到容器 /app/data/img_data）
UPLOAD_PATH_HOST=

# variables: 容器内上传路径（对应后端配置项 sky.upload-path）
SKY_UPLOAD_PATH=/app/data/img_data/

# variables: 上传返回的访问前缀（对应后端配置项 sky.upload-access-url-prefix）
UPLOAD_ACCESS_URL_PREFIX=

# variables: 数据库连接
SKY_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=
DB_USER=

# secrets: 数据库密码
DB_PASSWORD=

# secrets: Redis 密码（可留空=不启用密码；若填写会启用 requirepass 并注入后端）
REDIS_PASSWORD=

# variables: Redis database（默认 0）
SKY_REDIS_DATABASE=0

# secrets: JWT 密钥（管理端/用户端）
JWT_ADMIN_KEY=
JWT_USER_KEY=

# variables: JWT 配置（毫秒/请求头名称）
JWT_ADMIN_TTL=7200000
JWT_ADMIN_TOKEN_NAME=token
JWT_USER_TTL=7200000
JWT_USER_TOKEN_NAME=authentication

# secrets: 微信小程序配置
WECHAT_APPID=
WECHAT_SECRET=
