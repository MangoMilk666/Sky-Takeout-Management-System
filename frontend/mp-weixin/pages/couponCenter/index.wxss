.page {
  background: #f6f6f6;
  min-height: 100vh;
}

.content {
  padding: 20rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tag {
  font-size: 22rpx;
  color: #333;
  background: #ffc200;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.line {
  display: flex;
  margin-top: 8rpx;
  font-size: 26rpx;
}

.label {
  color: #666;
  width: 120rpx;
}

.value {
  color: #333;
  flex: 1;
}

.card-ft {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.btn {
  background: #ffc200;
  color: #333;
  border: none;
  font-size: 26rpx;
  line-height: 72rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
}

.btn::after {
  border: none;
}
