.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 测试专用标识条 */
.test-badge {
  background: linear-gradient(135deg, #e95f3c, #ff8c42);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.test-badge-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

/* 订单信息卡片 */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.amount-row {
  margin-top: 16rpx;
}
.order-label {
  font-size: 26rpx;
  color: #999;
}
.order-value {
  font-size: 26rpx;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-amount {
  font-size: 52rpx;
  font-weight: bold;
  color: #e95f3c;
}
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

/* 选择区域 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.section-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 28rpx;
}

/* 支付按钮 */
.pay-btn {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  padding: 0;
  line-height: normal;
  border: none;
}
.pay-btn::after {
  border: none;
}
.pay-btn-inner {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}
.pay-btn-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  line-height: 1;
}
.pay-btn-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}
.pay-btn-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}
.pay-btn-desc {
  font-size: 22rpx;
  opacity: 0.75;
}

/* 微信正式支付：绿色 */
.pay-btn-real {
  background: #07c160;
  color: #fff;
}
.pay-btn-real[disabled] {
  background: #a0d9b4;
  color: #fff;
}

/* 测试模式：白底带边框 */
.pay-btn-test {
  background: #fff;
  color: #333;
  border: 2rpx solid #ddd;
}
.pay-btn-test[disabled] {
  opacity: 0.5;
}

/* 底部提示 */
.tip {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  padding: 16rpx 24rpx 32rpx;
  line-height: 1.6;
}
